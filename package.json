{
  "name": "modelador-refactor",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs && npm run test:components",
    "test:components": "node --import tsx --test tests/*.component.test.jsx",
    "test:e2e": "npm run build && playwright test",
    "test:rust": "bash scripts/cargo.sh test --manifest-path src-tauri/Cargo.toml --locked",
    "test:lab": "node --test lab/roofPlane/tests/*.test.mjs",
    "test:coverage": "npm run test:coverage:core && npm run test:coverage:store",
    "test:coverage:core": "node --test --experimental-test-coverage --test-coverage-include='src/core/**/*.js' --test-coverage-lines=90 tests/*.test.mjs",
    "test:coverage:store": "node --test --experimental-test-coverage --test-coverage-include='src/store/**/*.js' --test-coverage-lines=85 tests/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "format:check": "node scripts/check-format.mjs",
    "format:rust": "bash scripts/cargo.sh fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:check": "bash scripts/cargo.sh check --manifest-path src-tauri/Cargo.toml --locked",
    "codex:spec": "node scripts/codex-spec.mjs",
    "codex:dry-run": "node scripts/codex-spec.mjs --dry-run",
    "codex:audit": "node scripts/codex-spec.mjs --audit",
    "verify:migration": "node scripts/migration-manifest.mjs",
    "verify:artifacts": "node scripts/check-artifacts.mjs",
    "verify:derived": "node scripts/check-derived-contract.mjs",
    "verify:goldens": "node scripts/verify-artifact-goldens.mjs",
    "update:goldens": "node scripts/verify-artifact-goldens.mjs --write",
    "evidence:spec14": "node scripts/generate-spec14-evidence.mjs",
    "evidence:spec015b": "node scripts/generate-spec015b-evidence.mjs",
    "setup:verification-python": "bash scripts/setup-verification-python.sh",
    "audit:dxf": "node scripts/audit-dxf.mjs",
    "smoke:ccx": "node scripts/smoke-ccx.mjs",
    "validate": "npm run format:check && npm run format:rust && npm run lint && npm test && npm run test:rust && npm run tauri:check && npm run test:lab && npm run test:coverage && npm run verify:goldens && npm run audit:dxf && npm run smoke:ccx && npm run build && npm run verify:migration && npm run verify:artifacts && npm run verify:derived && npm run codex:audit && make governance",
    "evidence:spec015c": "node scripts/generate-spec015c-evidence.mjs",
    "verify:spec015c-independence": "node scripts/check-spec015c-independence.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "three-bvh-csg": "^0.0.18",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.3",
    "eslint": "9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "29.1.1",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "tsx": "4.19.4",
    "vite": "^5.4.0"
  }
}
