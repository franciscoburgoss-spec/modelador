{
  "name": "modelador-refactor",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "test:lab": "node --test lab/roofPlane/tests/*.test.mjs",
    "test:coverage": "npm run test:coverage:core && npm run test:coverage:store",
    "test:coverage:core": "node --test --experimental-test-coverage --test-coverage-include='src/core/**/*.js' --test-coverage-lines=90 tests/*.test.mjs",
    "test:coverage:store": "node --test --experimental-test-coverage --test-coverage-include='src/store/**/*.js' --test-coverage-lines=50 tests/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "format:check": "node scripts/check-format.mjs",
    "build": "vite build",
    "verify:migration": "node scripts/migration-manifest.mjs",
    "verify:artifacts": "node scripts/check-artifacts.mjs",
    "verify:derived": "node scripts/check-derived-contract.mjs",
    "validate": "npm run format:check && npm run lint && npm test && npm run test:lab && npm run test:coverage && npm run build && npm run verify:migration && npm run verify:artifacts && npm run verify:derived && make governance"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "three-bvh-csg": "^0.0.18",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.3",
    "eslint": "9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.0"
  }
}
